# Copy to config/.env.local for local development. Never commit real values.
# Public Firebase web configuration: these values are visible in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Server only. Set these in your hosting provider's environment settings too.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the PEM on one quoted line, with literal \n between its lines.
FIREBASE_PRIVATE_KEY=""
# Alternatively use a server-side credential file (local development only).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/config/credentials/firebase-admin.json
AUTH_SECRET=
AUTH_COOKIE_NAME=app_session

# Future LINE Messaging API integration. Keep both server only.
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
